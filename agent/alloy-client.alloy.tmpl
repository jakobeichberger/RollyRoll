// =====================================================================
// Grafana Alloy auf Windows-Servern und -Clients der Schule
//
// Diese Datei wird auf dem Monitoring-Server erzeugt (pakete-holen.sh)
// und vom Agenten beim Ausrollen heruntergeladen. Anpassungen also bitte
// an der Vorlage agent/alloy-client.alloy.tmpl vornehmen – dann gelten
// sie beim naechsten Neustart auf allen Geraeten.
//
// Ersetzt werden:
//   __MON_HOSTNAME__ / __AGENT_TOKEN__  auf dem Server
//   __GERAET__ / __ROLLE__ / __STANDORT__  auf dem jeweiligen Client
// =====================================================================

logging {
  level  = "warn"
  format = "logfmt"
}

// ---------------------------------------------------------------- //
// Ziel: Loki auf dem Monitoring-Server
// ---------------------------------------------------------------- //
loki.write "zentral" {
  endpoint {
    url = "http://__MON_HOSTNAME__/loki/api/v1/push"

    basic_auth {
      username = "agent"
      password = "__AGENT_TOKEN__"
    }

    // Bei Netzstoerungen nicht sofort aufgeben – die Schule hat
    // gelegentlich Aussetzer, Protokolle sollen trotzdem ankommen.
    max_backoff_period = "5m"
    batch_wait         = "3s"
    batch_size         = "1MiB"
  }

  external_labels = {
    geraet   = "__GERAET__",
    rolle    = "__ROLLE__",
    standort = "__STANDORT__",
  }

  // Puffert auf Platte, falls der Server kurz weg ist
  wal {
    enabled           = true
    max_segment_age   = "1h"
    drain_timeout     = "30s"
  }
}

// ---------------------------------------------------------------- //
// Aufbereitung: Kanal und Ereignisnummer als Labels bzw. Metadaten
// ---------------------------------------------------------------- //
loki.process "ereignisse" {
  forward_to = [loki.write.zentral.receiver]

  stage.json {
    expressions = {
      event_id_roh = "event_id",
      level_roh    = "levelText",
      quelle_roh   = "source",
    }
  }

  // event_id bleibt bewusst KEIN Label: bei mehreren hundert
  // Ereignisnummern mal hunderten Geraeten wuerde Loki sonst in
  // zu viele Datenstroeme zerfallen. Als strukturierte Metadaten ist
  // die Nummer trotzdem schnell filterbar.
  stage.structured_metadata {
    values = {
      event_id = "event_id_roh",
      stufe    = "level_roh",
      anbieter = "quelle_roh",
    }
  }

  stage.drop {
    longer_than = "128kb"
  }
}

// ---------------------------------------------------------------- //
// Sicherheitsprotokoll
// Bewusst gefiltert: nur Ereignisse mit Aussagekraft fuer die
// Angriffserkennung. Sonst erschlaegt allein 4634 (Abmeldung) alles.
// ---------------------------------------------------------------- //
loki.source.windowsevent "sicherheit" {
  eventlog_name          = "Security"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\sicherheit.xml"
  poll_interval          = "10s"
  use_incoming_timestamp = true
  exclude_event_data     = false
  exclude_user_data      = true

  xpath_query = "*[System[(EventID=1102 or EventID=4624 or EventID=4625 or EventID=4648 or EventID=4662 or EventID=4672 or EventID=4688 or EventID=4697 or EventID=4698 or EventID=4699 or EventID=4702 or EventID=4719 or EventID=4720 or EventID=4722 or EventID=4723 or EventID=4724 or EventID=4725 or EventID=4726 or EventID=4728 or EventID=4729 or EventID=4732 or EventID=4733 or EventID=4738 or EventID=4740 or EventID=4756 or EventID=4757 or EventID=4767 or EventID=4769 or EventID=4771 or EventID=4776 or EventID=4778 or EventID=4779 or EventID=4794 or EventID=4964 or EventID=5136)]]"

  labels = {
    job     = "windows_events",
    channel = "Security",
  }

  forward_to = [loki.process.ereignisse.receiver]
}

// ---------------------------------------------------------------- //
// Systemprotokoll – Hardware, Dienste, Abstuerze
// ---------------------------------------------------------------- //
loki.source.windowsevent "system" {
  eventlog_name          = "System"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\system.xml"
  poll_interval          = "15s"
  use_incoming_timestamp = true

  // Level 1 = kritisch, 2 = Fehler, 3 = Warnung
  // dazu gezielt die Ereignisse, die auch als "Information" kommen
  // koennen, aber wichtig sind (neuer Dienst, unerwarteter Neustart).
  //
  // Die Hardware-Anbieter sind hier bewusst ausgeklammert – die holt der
  // eigene Block weiter unten vollstaendig ab, damit nichts doppelt
  // gespeichert wird.
  xpath_query = "*[System[(Level=1 or Level=2 or Level=3) or (EventID=41 or EventID=1001 or EventID=6005 or EventID=6006 or EventID=6008 or EventID=7045 or EventID=1074)]] and *[System[not(Provider[@Name='Microsoft-Windows-WHEA-Logger' or @Name='disk' or @Name='Disk' or @Name='Ntfs' or @Name='volmgr' or @Name='volsnap' or @Name='storahci' or @Name='stornvme' or @Name='iaStorA' or @Name='megasas' or @Name='megasas2' or @Name='HpCISSs3' or @Name='mpio' or @Name='msiscsi' or @Name='Microsoft-Windows-StorPort' or @Name='Microsoft-Windows-Kernel-Power' or @Name='Microsoft-Windows-Kernel-Processor-Power' or @Name='BugCheck' or @Name='Microsoft-Windows-WER-SystemErrorReporting' or @Name='Microsoft-Windows-Ntfs' or @Name='e1iexpress' or @Name='EhStorClass'])]]"

  labels = {
    job     = "windows_events",
    channel = "System",
  }

  forward_to = [loki.process.ereignisse.receiver]
}

// ---------------------------------------------------------------- //
// Anwendungsprotokoll – nur Fehler und Kritisches
// ---------------------------------------------------------------- //
loki.source.windowsevent "anwendung" {
  eventlog_name          = "Application"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\anwendung.xml"
  poll_interval          = "30s"
  use_incoming_timestamp = true

  xpath_query = "*[System[(Level=1 or Level=2)]]"

  labels = {
    job     = "windows_events",
    channel = "Application",
  }

  forward_to = [loki.process.ereignisse.receiver]
}

// ---------------------------------------------------------------- //
// Microsoft Defender – Funde, abgeschaltete Schutzfunktionen
// ---------------------------------------------------------------- //
loki.source.windowsevent "defender" {
  eventlog_name          = "Microsoft-Windows-Windows Defender/Operational"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\defender.xml"
  poll_interval          = "15s"
  use_incoming_timestamp = true

  labels = {
    job     = "windows_events",
    channel = "Defender",
  }

  forward_to = [loki.process.ereignisse.receiver]
}

// ---------------------------------------------------------------- //
// PowerShell – Skriptblock-Protokollierung
// Nur sinnvoll, wenn "Script Block Logging" per GPO aktiv ist
// (siehe docs/06-security-monitoring.md). Ohne die Einstellung
// bleibt der Kanal einfach leer.
// ---------------------------------------------------------------- //
loki.source.windowsevent "powershell" {
  eventlog_name          = "Microsoft-Windows-PowerShell/Operational"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\powershell.xml"
  poll_interval          = "15s"
  use_incoming_timestamp = true

  xpath_query = "*[System[(EventID=4103 or EventID=4104)]]"

  labels = {
    job     = "windows_events",
    channel = "PowerShell",
  }

  forward_to = [loki.process.ereignisse.receiver]
}

// ---------------------------------------------------------------- //
// Hardware
//
// Ausgewaehlt wird nach ANBIETER, nicht nach Schweregrad – und das ist
// der entscheidende Punkt: WHEA protokolliert korrigierte Hardwarefehler
// haeufig als "Information". Genau diese Eintraege sind die frueheste
// Vorwarnung, die es fuer sterbenden Arbeitsspeicher oder eine kippende
// PCIe-Verbindung ueberhaupt gibt. Ein Filter nach Level 1-3 wuerde sie
// wegwerfen.
//
// Ebenfalls dabei: Controller-Ruecksetzungen (storahci/stornvme 129),
// fehlerhafte Bloecke (disk 7/51/153), Dateisystemfehler (Ntfs 55),
// Bluescreens (BugCheck 1001) und unerwartete Neustarts (Kernel-Power 41).
// ---------------------------------------------------------------- //
loki.source.windowsevent "hardware" {
  eventlog_name          = "System"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\hardware.xml"
  poll_interval          = "15s"
  use_incoming_timestamp = true
  exclude_event_data     = false

  xpath_query = "*[System[Provider[@Name='Microsoft-Windows-WHEA-Logger' or @Name='disk' or @Name='Disk' or @Name='Ntfs' or @Name='volmgr' or @Name='volsnap' or @Name='storahci' or @Name='stornvme' or @Name='iaStorA' or @Name='megasas' or @Name='megasas2' or @Name='HpCISSs3' or @Name='mpio' or @Name='msiscsi' or @Name='Microsoft-Windows-StorPort' or @Name='Microsoft-Windows-Kernel-Power' or @Name='Microsoft-Windows-Kernel-Processor-Power' or @Name='BugCheck' or @Name='Microsoft-Windows-WER-SystemErrorReporting' or @Name='Microsoft-Windows-Ntfs' or @Name='e1iexpress' or @Name='EhStorClass']]]"

  labels = {
    job     = "windows_events",
    channel = "Hardware",
  }

  forward_to = [loki.process.ereignisse.receiver]
}

// ---------------------------------------------------------------- //
// Hardware-Verwaltungsprogramme der Hersteller
//
// Dell OpenManage, HPE Smart Storage, LSI/Broadcom MegaRAID und Lenovo
// XClarity melden Plattenausfaelle, defekte Netzteile und Luefter in das
// Anwendungsprotokoll. Ist keines davon installiert, bleibt der Kanal
// einfach leer – das kostet nichts.
// ---------------------------------------------------------------- //
loki.source.windowsevent "hardware_hersteller" {
  eventlog_name          = "Application"
  bookmark_path          = "C:\\ProgramData\\SchulMonitoring\\alloy\\hardware-hersteller.xml"
  poll_interval          = "30s"
  use_incoming_timestamp = true

  xpath_query = "*[System[Provider[@Name='Server Administrator' or @Name='cissesrv' or @Name='MR_MONITOR' or @Name='MegaRAID' or @Name='IPMIDRV' or @Name='Lenovo XClarity' or @Name='ESMCommonService' or @Name='HpSmhCore' or @Name='Intel(R) Rapid Storage Technology']]]"

  labels = {
    job     = "windows_events",
    channel = "Hardware",
  }

  forward_to = [loki.process.ereignisse.receiver]
}
