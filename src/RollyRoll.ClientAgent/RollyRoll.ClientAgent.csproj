<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RollyRoll.ClientAgent</RootNamespace>
    <OutputType>Exe</OutputType>
    <Description>Lightweight agent running on managed Windows PCs for health reporting, patch installation, and auto-recovery</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RollyRoll.Core\RollyRoll.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.*" />
  </ItemGroup>

</Project>
