{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=RollyRoll.db"
  },
  "PxeSettings": {
    "TftpPort": 69,
    "DhcpProxyPort": 4011,
    "TftpRoot": "C:\\RollyRoll\\TftpRoot"
  },
  "ImageSettings": {
    "StorePath": "C:\\RollyRoll\\Images",
    "DefaultCompression": "Fast"
  },
  "NetworkSettings": {
    "ServerIp": "0.0.0.0",
    "ServerBaseUrl": "https://localhost:5001",
    "DiscoveryPort": 5150
  },
  "WolSettings": {
    "Port": 9,
    "Retries": 3,
    "RetryDelayMs": 500
  },
  "SecuritySettings": {
    "CertificatePath": "",
    "CertificatePassword": "",
    "RequireHttps": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "RollyRoll": "Information"
    }
  }
}
