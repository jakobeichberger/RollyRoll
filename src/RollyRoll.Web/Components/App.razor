<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RollyRoll - Windows Deployment Platform</title>
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <style>
        :root {
            --rr-bg: #0f1117;
            --rr-sidebar: #161822;
            --rr-card: #1c1f2e;
            --rr-border: #2a2d3e;
            --rr-accent: #6366f1;
            --rr-accent-hover: #818cf8;
            --rr-text: #e2e8f0;
            --rr-muted: #94a3b8;
            --rr-success: #22c55e;
            --rr-warning: #f59e0b;
            --rr-danger: #ef4444;
        }

        body {
            background-color: var(--rr-bg);
            color: var(--rr-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
        }

        .sidebar {
            background-color: var(--rr-sidebar);
            border-right: 1px solid var(--rr-border);
            width: 240px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            padding-top: 1rem;
        }

        .sidebar .brand {
            padding: 0.5rem 1.25rem 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--rr-accent);
            letter-spacing: -0.02em;
        }

        .sidebar .nav-link {
            color: var(--rr-muted);
            padding: 0.6rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.875rem;
            border-left: 3px solid transparent;
            transition: all 0.15s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: var(--rr-text);
            background-color: rgba(99, 102, 241, 0.08);
            border-left-color: var(--rr-accent);
        }

        .main-content {
            margin-left: 240px;
            padding: 2rem;
            min-height: 100vh;
        }

        .card-dark {
            background-color: var(--rr-card);
            border: 1px solid var(--rr-border);
            border-radius: 0.5rem;
        }

        .stat-card {
            background-color: var(--rr-card);
            border: 1px solid var(--rr-border);
            border-radius: 0.5rem;
            padding: 1.25rem;
        }

        .stat-card .stat-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-card .stat-label {
            color: var(--rr-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .btn-accent {
            background-color: var(--rr-accent);
            color: #fff;
            border: none;
        }

        .btn-accent:hover {
            background-color: var(--rr-accent-hover);
            color: #fff;
        }

        .table-dark-custom {
            --bs-table-bg: transparent;
            --bs-table-color: var(--rr-text);
            --bs-table-border-color: var(--rr-border);
            --bs-table-hover-bg: rgba(99, 102, 241, 0.06);
            --bs-table-hover-color: var(--rr-text);
        }

        .badge-online { background-color: var(--rr-success); }
        .badge-offline { background-color: #475569; }
        .badge-running { background-color: var(--rr-accent); }
        .badge-failed { background-color: var(--rr-danger); }
        .badge-queued { background-color: var(--rr-warning); color: #000; }

        .drag-over { outline: 2px dashed var(--rr-accent); outline-offset: -2px; }

        .form-control, .form-select {
            background-color: var(--rr-sidebar);
            border-color: var(--rr-border);
            color: var(--rr-text);
        }

        .form-control:focus, .form-select:focus {
            background-color: var(--rr-sidebar);
            border-color: var(--rr-accent);
            color: var(--rr-text);
            box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
        }

        .modal-content {
            background-color: var(--rr-card);
            border: 1px solid var(--rr-border);
            color: var(--rr-text);
        }
    </style>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
