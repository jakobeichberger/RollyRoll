@page "/audit-log"
@inject IAuditService AuditService

<PageTitle>Audit Log - RollyRoll</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Audit Log</h1>
    <button class="btn btn-outline-light" @onclick="ExportCsv">
        <i class="bi bi-file-earmark-arrow-down"></i> Export CSV
    </button>
</div>

@* ── Filters ── *@
<div class="card-dark p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select class="form-select" @bind="filterCategory">
                <option value="">All categories</option>
                @foreach (var cat in Enum.GetValues<AuditCategory>())
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" class="form-control" @bind="filterFrom" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" class="form-control" @bind="filterTo" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Performed By</label>
            <input type="text" class="form-control" @bind="filterUser" placeholder="Username..." />
        </div>
        <div class="col-md-2">
            <button class="btn btn-accent w-100" @onclick="ApplyFilters">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </div>
</div>

@* ── Results ── *@
<div class="card-dark">
    <div class="table-responsive">
        <table class="table table-dark-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Category</th>
                    <th>Action</th>
                    <th>Target</th>
                    <th>Performed By</th>
                    <th>Result</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (entries.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            @(isLoading ? "Loading..." : "No audit entries found.")
                        </td>
                    </tr>
                }
                @foreach (var entry in entries)
                {
                    <tr>
                        <td>@entry.Timestamp.ToString("g")</td>
                        <td><span class="badge @GetCategoryBadge(entry.Category)">@entry.Category</span></td>
                        <td>@entry.Action</td>
                        <td>@(entry.TargetName ?? "—")</td>
                        <td>@entry.PerformedBy</td>
                        <td>
                            @if (entry.Success)
                            {
                                <span class="badge badge-online">OK</span>
                            }
                            else
                            {
                                <span class="badge badge-failed" title="@entry.ErrorMessage">Failed</span>
                            }
                        </td>
                        <td>
                            <span class="text-muted small" title="@entry.Details">
                                @(entry.Details.Length > 80 ? entry.Details[..80] + "..." : entry.Details)
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination ── *@
    @if (totalCount > pageSize)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top" style="border-color: var(--rr-border) !important;">
            <span class="text-muted">Showing @(skip + 1)&ndash;@Math.Min(skip + pageSize, totalCount) of @totalCount entries</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" disabled="@(skip == 0)" @onclick="PreviousPage">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <button class="btn btn-sm btn-outline-light" disabled="@(skip + pageSize >= totalCount)" @onclick="NextPage">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<AuditLogEntry> entries = [];
    private bool isLoading = true;
    private int totalCount;
    private int skip;
    private int pageSize = 50;

    // Filters
    private string filterCategory = string.Empty;
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private string filterUser = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        isLoading = true;

        AuditCategory? category = string.IsNullOrEmpty(filterCategory)
            ? null
            : Enum.Parse<AuditCategory>(filterCategory);

        string? user = string.IsNullOrWhiteSpace(filterUser) ? null : filterUser.Trim();

        entries = await AuditService.GetEntriesAsync(
            category: category,
            from: filterFrom,
            to: filterTo?.AddDays(1),
            performedBy: user,
            skip: skip,
            take: pageSize);

        totalCount = await AuditService.GetCountAsync(
            category: category,
            from: filterFrom,
            to: filterTo?.AddDays(1),
            performedBy: user);

        isLoading = false;
    }

    private async Task ApplyFilters()
    {
        skip = 0;
        await LoadEntries();
    }

    private async Task PreviousPage()
    {
        skip = Math.Max(0, skip - pageSize);
        await LoadEntries();
    }

    private async Task NextPage()
    {
        skip += pageSize;
        await LoadEntries();
    }

    private async Task ExportCsv()
    {
        AuditCategory? category = string.IsNullOrEmpty(filterCategory)
            ? null
            : Enum.Parse<AuditCategory>(filterCategory);

        var csv = await AuditService.ExportCsvAsync(category, filterFrom, filterTo);
        // In a real app this would trigger a file download via JS interop
    }

    private static string GetCategoryBadge(AuditCategory category) => category switch
    {
        AuditCategory.Deployment => "bg-primary",
        AuditCategory.ImageCapture => "bg-info",
        AuditCategory.PatchManagement => "bg-warning text-dark",
        AuditCategory.Recovery => "bg-danger",
        AuditCategory.ClientManagement => "bg-secondary",
        AuditCategory.GroupManagement => "bg-secondary",
        AuditCategory.Settings => "bg-secondary",
        AuditCategory.Authentication => "bg-info",
        AuditCategory.WakeOnLan => "bg-secondary",
        AuditCategory.Scheduling => "bg-primary",
        _ => "bg-secondary"
    };
}
