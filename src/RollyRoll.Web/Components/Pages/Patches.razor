@page "/patches"
@using Microsoft.EntityFrameworkCore
@inject RollyRoll.Infrastructure.Data.RollyRollDbContext DbContext

<PageTitle>Patches - RollyRoll</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Patch Management</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-light" @onclick="SyncCatalog">
            <i class="bi bi-cloud-download"></i> Sync Catalog
        </button>
        <button class="btn btn-outline-light" @onclick="LoadData">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>
</div>

@* ── Compliance Summary ── *@
@if (compliance is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Clients</div>
                <div class="stat-value">@compliance.TotalClients</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Fully Patched</div>
                <div class="stat-value text-success">@compliance.FullyPatched</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Pending</div>
                <div class="stat-value" style="color: var(--rr-warning);">@compliance.PendingPatches</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Compliance</div>
                <div class="stat-value" style="color: var(--rr-accent);">@compliance.CompliancePercent.ToString("F1")%</div>
            </div>
        </div>
    </div>
}

@* ── Tabs: Available | Approved | Rollout Rings ── *@
<ul class="nav nav-tabs mb-3" style="border-color: var(--rr-border);">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "available" ? "active" : "")" style="@TabStyle("available")"
                @onclick='() => activeTab = "available"'>
            Available (@availablePatches.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "approved" ? "active" : "")" style="@TabStyle("approved")"
                @onclick='() => activeTab = "approved"'>
            Approved (@approvedPatches.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "rings" ? "active" : "")" style="@TabStyle("rings")"
                @onclick='() => activeTab = "rings"'>
            Rollout Rings
        </button>
    </li>
</ul>

@* ── Available Patches ── *@
@if (activeTab == "available")
{
    <div class="card-dark">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>KB</th>
                        <th>Source</th>
                        <th>Classification</th>
                        <th>Severity</th>
                        <th>Size</th>
                        <th>Released</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (availablePatches.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No unapproved patches.</td></tr>
                    }
                    @foreach (var patch in availablePatches)
                    {
                        <tr>
                            <td>@patch.Title</td>
                            <td><code>@patch.KbArticleId</code></td>
                            <td><span class="badge bg-secondary">@patch.Source</span></td>
                            <td>@patch.Classification</td>
                            <td>
                                <span class="badge @GetSeverityBadge(patch.Severity)">@patch.Severity</span>
                            </td>
                            <td>@FormatBytes(patch.SizeBytes)</td>
                            <td>@patch.ReleaseDate?.ToString("d")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => ApprovePatch(patch)">
                                    <i class="bi bi-check-lg"></i> Approve
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Approved Patches ── *@
@if (activeTab == "approved")
{
    <div class="card-dark">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>KB</th>
                        <th>Source</th>
                        <th>Severity</th>
                        <th>Approved By</th>
                        <th>Approved At</th>
                        <th>Reboot</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (approvedPatches.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No approved patches.</td></tr>
                    }
                    @foreach (var patch in approvedPatches)
                    {
                        <tr>
                            <td>@patch.Title</td>
                            <td><code>@patch.KbArticleId</code></td>
                            <td><span class="badge bg-secondary">@patch.Source</span></td>
                            <td><span class="badge @GetSeverityBadge(patch.Severity)">@patch.Severity</span></td>
                            <td>@patch.ApprovedBy</td>
                            <td>@patch.ApprovedAt?.ToString("g")</td>
                            <td>@(patch.RequiresReboot ? "Yes" : "No")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => RevokePatch(patch)">
                                    <i class="bi bi-x-lg"></i> Revoke
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Rollout Rings ── *@
@if (activeTab == "rings")
{
    <div class="row g-3">
        @foreach (var ring in rings.OrderBy(r => r.Order))
        {
            <div class="col-md-6 col-lg-3">
                <div class="card-dark p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">
                            <span class="badge bg-secondary me-1">@ring.Order</span>
                            @ring.Name
                        </h5>
                        <span class="badge @(ring.IsActive ? "badge-online" : "badge-offline")">
                            @(ring.IsActive ? "Active" : "Paused")
                        </span>
                    </div>
                    <p class="text-muted small mb-2">@ring.Description</p>
                    <div class="small mb-1">
                        <strong>Delay:</strong> @ring.DelayDaysAfterPrevious day(s) after previous ring
                    </div>
                    <div class="small mb-2">
                        <strong>Failure threshold:</strong> @ring.FailureThresholdPercent%
                    </div>
                    <div>
                        <strong class="small">Groups:</strong>
                        @if (ring.Groups.Any())
                        {
                            @foreach (var g in ring.Groups)
                            {
                                <span class="badge bg-secondary me-1">@g.Name</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">None assigned</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string activeTab = "available";
    private List<PatchPackage> availablePatches = [];
    private List<PatchPackage> approvedPatches = [];
    private List<PatchRolloutRing> rings = [];
    private PatchComplianceReport? compliance;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        availablePatches = await DbContext.PatchPackages.Where(p => !p.IsApproved).OrderByDescending(p => p.DiscoveredAt).ToListAsync();
        approvedPatches = await DbContext.PatchPackages.Where(p => p.IsApproved).OrderByDescending(p => p.ApprovedAt).ToListAsync();
        rings = await DbContext.PatchRolloutRings.Include(r => r.Groups).OrderBy(r => r.Order).ToListAsync();
        var totalClients = await DbContext.Clients.CountAsync();
        compliance = new PatchComplianceReport { TotalClients = totalClients, FullyPatched = totalClients };
    }

    private async Task SyncCatalog()
    {
        // TODO: Implement catalog sync when PatchService is ready
        await Task.CompletedTask;
        await LoadData();
    }

    private async Task ApprovePatch(PatchPackage patch)
    {
        patch.IsApproved = true;
        patch.ApprovedAt = DateTime.UtcNow;
        patch.ApprovedBy = "admin";
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task RevokePatch(PatchPackage patch)
    {
        patch.IsApproved = false;
        patch.ApprovedAt = null;
        patch.ApprovedBy = null;
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private static string GetSeverityBadge(PatchSeverity severity) => severity switch
    {
        PatchSeverity.Critical => "bg-danger",
        PatchSeverity.Important => "bg-warning text-dark",
        PatchSeverity.Moderate => "bg-info",
        PatchSeverity.Low => "bg-secondary",
        _ => "bg-secondary"
    };

    private string TabStyle(string tab) =>
        activeTab == tab
            ? "background: var(--rr-card); color: var(--rr-text); border-color: var(--rr-border) var(--rr-border) var(--rr-card);"
            : "background: transparent; color: var(--rr-muted); border-color: transparent;";

    private static string FormatBytes(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB", "TB"];
        int i = 0;
        double size = bytes;
        while (size >= 1024 && i < suffixes.Length - 1) { size /= 1024; i++; }
        return $"{size:F1} {suffixes[i]}";
    }
}
