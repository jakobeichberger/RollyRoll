@page "/schedule"
@inject IClientDiscoveryService ClientService
@inject IImageService ImageService
@inject IDeploymentService DeploymentService
@using Microsoft.EntityFrameworkCore
@inject RollyRoll.Infrastructure.Data.RollyRollDbContext DbContext

<PageTitle>Schedule - RollyRoll</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Schedule</h1>
    <button class="btn btn-accent" @onclick="ShowCreateDialog">
        <i class="bi bi-plus-lg"></i> New Scheduled Task
    </button>
</div>

@* ── Week Navigation ── *@
<div class="d-flex align-items-center gap-3 mb-4">
    <button class="btn btn-sm btn-outline-light" @onclick="PreviousWeek">
        <i class="bi bi-chevron-left"></i>
    </button>
    <h5 class="mb-0">@weekStart.ToString("MMM d") &ndash; @weekEnd.ToString("MMM d, yyyy")</h5>
    <button class="btn btn-sm btn-outline-light" @onclick="NextWeek">
        <i class="bi bi-chevron-right"></i>
    </button>
    <button class="btn btn-sm btn-outline-light" @onclick="GoToToday">Today</button>
</div>

@* ── Timetable Grid ── *@
<div class="card-dark p-3">
    <div class="row g-0">
        @for (int d = 0; d < 7; d++)
        {
            var day = weekStart.AddDays(d);
            var dayTasks = tasksThisWeek.Where(t => t.ScheduledAt?.Date == day.Date).OrderBy(t => t.ScheduledAt).ToList();
            var isToday = day.Date == DateTime.Today;

            <div class="col border-end" style="border-color: var(--rr-border) !important; min-height: 300px;">
                <div class="text-center py-2 border-bottom" style="border-color: var(--rr-border) !important; @(isToday ? "background: rgba(99,102,241,0.1);" : "")">
                    <div class="small text-muted">@day.ToString("ddd")</div>
                    <div class="fw-bold @(isToday ? "" : "")">@day.Day</div>
                </div>
                <div class="p-2">
                    @foreach (var task in dayTasks)
                    {
                        <div class="mb-2 p-2 rounded" style="background: var(--rr-sidebar); font-size: 0.8rem;">
                            <div class="d-flex justify-content-between">
                                <span class="badge @GetStatusBadge(task.Status) mb-1">@task.TaskType</span>
                                <button class="btn btn-sm p-0 text-danger" @onclick="() => CancelTask(task)" title="Cancel">
                                    <i class="bi bi-x-circle" style="font-size: 0.75rem;"></i>
                                </button>
                            </div>
                            <div class="fw-bold">@task.Name</div>
                            <div class="text-muted">@task.ScheduledAt?.ToString("HH:mm")</div>
                            @if (task.Client is not null)
                            {
                                <div class="text-muted"><i class="bi bi-pc-display"></i> @task.Client.Hostname</div>
                            }
                            @if (task.Group is not null)
                            {
                                <div class="text-muted"><i class="bi bi-diagram-3"></i> @task.Group.Name</div>
                            }
                        </div>
                    }
                    @if (!dayTasks.Any())
                    {
                        <div class="text-center text-muted small py-3">No tasks</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@* ── All Scheduled Tasks Table ── *@
<div class="card-dark p-3 mt-4">
    <h5 class="mb-3">All Scheduled Tasks</h5>
    <div class="table-responsive">
        <table class="table table-dark-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Target</th>
                    <th>Scheduled</th>
                    <th>Recurring</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in allScheduled)
                {
                    <tr>
                        <td>@task.Name</td>
                        <td><span class="badge bg-secondary">@task.TaskType</span></td>
                        <td>
                            @if (task.Client is not null) { @task.Client.Hostname }
                            else if (task.Group is not null) { @task.Group.Name }
                            else { <span class="text-muted">--</span> }
                        </td>
                        <td>@task.ScheduledAt?.ToString("g")</td>
                        <td>@(string.IsNullOrEmpty(task.CronExpression) ? "One-time" : task.CronExpression)</td>
                        <td><span class="badge @GetStatusBadge(task.Status)">@task.Status</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelTask(task)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Create Task Dialog ── *@
@if (showCreate)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-bottom" style="border-color: var(--rr-border) !important;">
                    <h5 class="modal-title">Schedule New Task</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showCreate = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Task Name</label>
                            <input type="text" class="form-control" @bind="newTask.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Task Type</label>
                            <select class="form-select" @bind="newTask.TaskType">
                                @foreach (var t in Enum.GetValues<ScheduledTaskType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Target Client</label>
                            <select class="form-select" @bind="newTask.ClientId">
                                <option value="">None (use group)</option>
                                @foreach (var c in allClients)
                                {
                                    <option value="@c.Id">@c.Hostname (@c.MacAddress)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Target Group</label>
                            <select class="form-select" @bind="newTask.GroupId">
                                <option value="">None</option>
                                @foreach (var g in allGroups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Scheduled Date/Time</label>
                            <input type="datetime-local" class="form-control" @bind="scheduledDateTime" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cron (optional, for recurring)</label>
                            <input type="text" class="form-control" @bind="newTask.CronExpression" placeholder="e.g. 0 2 * * 0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Image (for Deploy/Capture)</label>
                            <select class="form-select" @bind="newTask.ImageId">
                                <option value="">None</option>
                                @foreach (var img in allImages)
                                {
                                    <option value="@img.Id">@img.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Deploy Mode</label>
                            <select class="form-select" @bind="newTask.DeployMode">
                                @foreach (var m in Enum.GetValues<DeployMode>())
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color: var(--rr-border) !important;">
                    <button class="btn btn-secondary" @onclick="() => showCreate = false">Cancel</button>
                    <button class="btn btn-accent" @onclick="CreateTask" disabled="@string.IsNullOrWhiteSpace(newTask.Name)">
                        <i class="bi bi-calendar-plus"></i> Schedule
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime weekStart;
    private DateTime weekEnd;
    private List<ScheduledTask> tasksThisWeek = [];
    private List<ScheduledTask> allScheduled = [];
    private List<Client> allClients = [];
    private List<ClientGroup> allGroups = [];
    private List<Image> allImages = [];

    // Create dialog
    private bool showCreate;
    private ScheduledTask newTask = new();
    private DateTime scheduledDateTime = DateTime.Now.AddHours(1);

    protected override async Task OnInitializedAsync()
    {
        SetWeek(DateTime.Today);
        await LoadData();
    }

    private void SetWeek(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        weekStart = date.AddDays(-diff).Date;
        weekEnd = weekStart.AddDays(6);
    }

    private async Task LoadData()
    {
        allScheduled = await DbContext.ScheduledTasks
            .Include(t => t.Client).Include(t => t.Group).Include(t => t.Image)
            .Where(t => t.ScheduledAt != null)
            .OrderBy(t => t.ScheduledAt)
            .ToListAsync();
        tasksThisWeek = allScheduled
            .Where(t => t.ScheduledAt >= weekStart && t.ScheduledAt <= weekEnd.AddDays(1))
            .ToList();
        allClients = await ClientService.GetAllClientsAsync();
        allGroups = await DbContext.ClientGroups.ToListAsync();
        allImages = await ImageService.GetAllImagesAsync();
    }

    private async Task PreviousWeek()
    {
        SetWeek(weekStart.AddDays(-7));
        await LoadData();
    }

    private async Task NextWeek()
    {
        SetWeek(weekStart.AddDays(7));
        await LoadData();
    }

    private async Task GoToToday()
    {
        SetWeek(DateTime.Today);
        await LoadData();
    }

    private async Task ShowCreateDialog()
    {
        newTask = new ScheduledTask { CreatedBy = "admin" };
        scheduledDateTime = DateTime.Now.AddHours(1);
        showCreate = true;
        await Task.CompletedTask;
    }

    private async Task CreateTask()
    {
        newTask.ScheduledAt = scheduledDateTime;

        newTask.Status = DeploymentTaskStatus.Scheduled;
        newTask.CreatedAt = DateTime.UtcNow;
        DbContext.ScheduledTasks.Add(newTask);
        await DbContext.SaveChangesAsync();

        showCreate = false;
        await LoadData();
    }

    private async Task CancelTask(ScheduledTask task)
    {
        await DeploymentService.CancelDeploymentAsync(task.Id);
        await LoadData();
    }

    private static string GetStatusBadge(DeploymentTaskStatus status) => status switch
    {
        DeploymentTaskStatus.Queued => "badge-queued",
        DeploymentTaskStatus.Scheduled => "bg-info",
        DeploymentTaskStatus.Running => "badge-running",
        DeploymentTaskStatus.Success => "badge-online",
        DeploymentTaskStatus.Failed => "badge-failed",
        DeploymentTaskStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}
