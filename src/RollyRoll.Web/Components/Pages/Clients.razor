@page "/clients"
@inject IClientDiscoveryService ClientService
@inject IDeploymentService DeploymentService
@inject IImageService ImageService

<PageTitle>Clients - RollyRoll</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Clients</h1>
    <div class="d-flex gap-2">
        <input type="text" class="form-control" placeholder="Search hostname, MAC, IP..."
               @bind="searchQuery" @bind:event="oninput" @onkeyup="OnSearch" style="width: 300px;" />
        <button class="btn btn-accent" @onclick="RefreshClients">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>
</div>

<div class="card-dark">
    <div class="table-responsive">
        <table class="table table-dark-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>MAC Address</th>
                    <th>IP Address</th>
                    <th>OS</th>
                    <th>Group</th>
                    <th>Status</th>
                    <th>Last Seen</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (filteredClients.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            @(isLoading ? "Loading clients..." : "No clients found.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var client in filteredClients)
                    {
                        <tr draggable="true"
                            @ondragstart="() => DragStartClient(client)"
                            style="cursor: grab;">
                            <td>
                                <i class="bi bi-pc-display me-1"></i>
                                @(string.IsNullOrEmpty(client.Hostname) ? "(unknown)" : client.Hostname)
                            </td>
                            <td><code>@client.MacAddress</code></td>
                            <td>@client.IpAddress</td>
                            <td>@(string.IsNullOrEmpty(client.OsVersion) ? "—" : client.OsVersion)</td>
                            <td>
                                @if (client.Group is not null)
                                {
                                    <span class="badge bg-secondary">@client.Group.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>
                            <td>
                                @if (client.IsOnline)
                                {
                                    <span class="badge badge-online">Online</span>
                                }
                                else
                                {
                                    <span class="badge badge-offline">Offline</span>
                                }
                                @if (!client.IsApproved)
                                {
                                    <span class="badge badge-queued ms-1">Pending</span>
                                }
                            </td>
                            <td>
                                @(client.LastSeen.HasValue ? client.LastSeen.Value.ToString("g") : "Never")
                            </td>
                            <td>
                                @if (!client.IsApproved)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ApproveClient(client)">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteClient(client)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Client> allClients = [];
    private List<Client> filteredClients = [];
    private string searchQuery = string.Empty;
    private bool isLoading = true;

    /// <summary>Exposes the currently dragged client to other components (e.g. Groups page).</summary>
    public static Client? DraggedClient { get; private set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        isLoading = true;
        allClients = await ClientService.GetAllClientsAsync();
        ApplyFilter();
        isLoading = false;
    }

    private void OnSearch()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredClients = allClients;
        }
        else
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            filteredClients = allClients.Where(c =>
                c.Hostname.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                c.MacAddress.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                c.IpAddress.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                c.SerialNumber.Contains(q, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private async Task RefreshClients()
    {
        await LoadClients();
    }

    private void DragStartClient(Client client)
    {
        DraggedClient = client;
    }

    private async Task ApproveClient(Client client)
    {
        await ClientService.ApproveClientAsync(client.Id);
        client.IsApproved = true;
    }

    private async Task DeleteClient(Client client)
    {
        await ClientService.DeleteClientAsync(client.Id);
        allClients.Remove(client);
        ApplyFilter();
    }
}
