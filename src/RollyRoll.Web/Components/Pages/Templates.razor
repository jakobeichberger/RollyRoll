@page "/templates"
@inject IImageService ImageService
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject RollyRoll.Infrastructure.Data.RollyRollDbContext DbContext

<PageTitle>Templates - RollyRoll</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Deployment Templates</h1>
    <button class="btn btn-accent" @onclick="CreateNew">
        <i class="bi bi-plus-lg"></i> New Template
    </button>
</div>

@if (!showEditor)
{
    <div class="row g-3">
        @if (templates.Count == 0)
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-file-earmark-code" style="font-size: 3rem;"></i>
                <p class="mt-2">No deployment templates yet. Create one to define reusable deployment workflows.</p>
            </div>
        }
        @foreach (var tmpl in templates)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-dark p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">@tmpl.Name</h5>
                        <div>
                            <button class="btn btn-sm btn-outline-light" @onclick="() => EditTemplate(tmpl)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteTemplate(tmpl)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">@tmpl.Description</p>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge bg-secondary">@tmpl.DefaultDeployMode</span>
                        @if (tmpl.SendWakeOnLan) { <span class="badge bg-info">WoL</span> }
                        @if (tmpl.JoinDomain) { <span class="badge bg-warning text-dark">Domain Join</span> }
                        @if (tmpl.RebootAfterDeploy) { <span class="badge bg-secondary">Reboot</span> }
                    </div>
                    @{
                        var steps = DeserializeSteps(tmpl.PostDeployStepsJson);
                    }
                    <small class="text-muted">@steps.Count post-deploy step(s) &middot; @tmpl.TimeoutMinutes min timeout</small>
                </div>
            </div>
        }
    </div>
}
else
{
    @* ── Template Editor ── *@
    <div class="card-dark p-4">
        <h4 class="mb-3">@(editingTemplate?.Id > 0 ? "Edit Template" : "New Template")</h4>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="editingTemplate!.Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Image</label>
                <select class="form-select" @bind="editingTemplate!.ImageId">
                    <option value="">Prompt at deploy time</option>
                    @foreach (var img in allImages)
                    {
                        <option value="@img.Id">@img.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="2" @bind="editingTemplate!.Description"></textarea>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">Deploy Mode</label>
                <select class="form-select" @bind="editingTemplate!.DefaultDeployMode">
                    @foreach (var mode in Enum.GetValues<DeployMode>())
                    {
                        <option value="@mode">@mode</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Timeout (minutes)</label>
                <input type="number" class="form-control" @bind="editingTemplate!.TimeoutMinutes" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="editingTemplate!.SendWakeOnLan" id="chkWol" />
                    <label class="form-check-label" for="chkWol">Send WoL</label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="editingTemplate!.JoinDomain" id="chkDomain" />
                    <label class="form-check-label" for="chkDomain">Join Domain</label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="editingTemplate!.RebootAfterDeploy" id="chkReboot" />
                    <label class="form-check-label" for="chkReboot">Reboot After</label>
                </div>
            </div>
        </div>

        @if (editingTemplate!.JoinDomain)
        {
            <div class="mb-3">
                <label class="form-label">Domain OU Path (LDAP)</label>
                <input type="text" class="form-control" @bind="editingTemplate!.DomainOuPath"
                       placeholder="OU=Workstations,DC=contoso,DC=com" />
            </div>
        }

        @* ── Post-Deploy Steps ── *@
        <h5 class="mt-4 mb-3">Post-Deploy Steps</h5>
        @for (int i = 0; i < editingSteps.Count; i++)
        {
            var step = editingSteps[i];
            var index = i;
            <div class="card-dark p-3 mb-2" style="background: var(--rr-sidebar);">
                <div class="row g-2 align-items-center">
                    <div class="col-md-1 text-center">
                        <span class="badge bg-secondary">@(index + 1)</span>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" @bind="step.StepType">
                            @foreach (var st in Enum.GetValues<DeploymentStepType>())
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control form-control-sm" @bind="step.Name" placeholder="Step name" />
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control form-control-sm" @bind="step.Command" placeholder="Command / path" />
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control form-control-sm" @bind="step.Arguments" placeholder="Arguments" />
                    </div>
                    <div class="col-md-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="step.ContinueOnFailure" title="Continue on failure" />
                        </div>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveStep(index)">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
        <button class="btn btn-sm btn-outline-light" @onclick="AddStep">
            <i class="bi bi-plus"></i> Add Step
        </button>

        <hr style="border-color: var(--rr-border);" />
        <div class="d-flex gap-2">
            <button class="btn btn-accent" @onclick="SaveTemplate">
                <i class="bi bi-check-lg"></i> Save Template
            </button>
            <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
        </div>
    </div>
}

@code {
    private List<DeploymentTemplate> templates = [];
    private List<Image> allImages = [];
    private bool showEditor;
    private DeploymentTemplate? editingTemplate;
    private List<DeploymentStep> editingSteps = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        templates = await DbContext.DeploymentTemplates.Include(t => t.Image).ToListAsync();
        allImages = await ImageService.GetAllImagesAsync();
    }

    private void CreateNew()
    {
        editingTemplate = new DeploymentTemplate();
        editingSteps = [];
        showEditor = true;
    }

    private void EditTemplate(DeploymentTemplate tmpl)
    {
        editingTemplate = tmpl;
        editingSteps = DeserializeSteps(tmpl.PostDeployStepsJson);
        showEditor = true;
    }

    private async Task SaveTemplate()
    {
        if (editingTemplate is null) return;

        // Assign order to steps
        for (int i = 0; i < editingSteps.Count; i++)
            editingSteps[i].Order = i + 1;

        editingTemplate.PostDeployStepsJson = JsonSerializer.Serialize(editingSteps);
        editingTemplate.UpdatedAt = DateTime.UtcNow;

        if (editingTemplate.Id == 0)
        {
            DbContext.DeploymentTemplates.Add(editingTemplate);
        }

        await DbContext.SaveChangesAsync();
        showEditor = false;
        await LoadTemplates();
    }

    private void CancelEdit()
    {
        showEditor = false;
    }

    private async Task DeleteTemplate(DeploymentTemplate tmpl)
    {
        DbContext.DeploymentTemplates.Remove(tmpl);
        await DbContext.SaveChangesAsync();
        templates.Remove(tmpl);
    }

    private void AddStep()
    {
        editingSteps.Add(new DeploymentStep
        {
            Order = editingSteps.Count + 1,
            StepType = DeploymentStepType.RunScript,
            TimeoutSeconds = 600
        });
    }

    private void RemoveStep(int index)
    {
        editingSteps.RemoveAt(index);
    }

    private static List<DeploymentStep> DeserializeSteps(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<List<DeploymentStep>>(json) ?? [];
        }
        catch
        {
            return [];
        }
    }
}
