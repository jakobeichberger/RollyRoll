---
# Ergaenzung zur mitgelieferten snmp.yml des snmp_exporter.
# bootstrap.sh erzeugt daraus snmp-schule.yml und setzt den Community-String
# aus .env ein. Die Standardmodule (if_mib, ubiquiti_unifi, printer_mib, ...)
# kommen weiterhin aus der Datei im Container.

auths:
  schule_v2:
    community: ${SNMP_COMMUNITY}
    security_level: noAuthNoPriv
    auth_protocol: MD5
    priv_protocol: DES
    version: 2

modules:

  # ================================================================ #
  # FortiGate – Hardware-Sensoren, Systemlast, VPN-Tunnel
  # Die MIB-Werte sind fest verdrahtet, es muss keine MIB geladen werden.
  # ================================================================ #
  fortigate_schule:
    walk:
      - 1.3.6.1.2.1.1              # system
      - 1.3.6.1.4.1.12356.101.4.1  # fgSystemInfo
      - 1.3.6.1.4.1.12356.101.4.3.2  # fgHwSensorTable
      - 1.3.6.1.4.1.12356.101.12.2.2 # fgVpnTunTable
      - 1.3.6.1.4.1.12356.101.13.2.1 # fgHaStatsTable
    max_repetitions: 20
    timeout: 10s
    retries: 2
    metrics:

      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3
        type: gauge
        help: Betriebszeit in Hundertstelsekunden

      - name: fgSysVersion
        oid: 1.3.6.1.4.1.12356.101.4.1.1
        type: DisplayString
        help: FortiOS-Version

      - name: fgSysCpuUsage
        oid: 1.3.6.1.4.1.12356.101.4.1.3
        type: gauge
        help: CPU-Auslastung in Prozent

      - name: fgSysMemUsage
        oid: 1.3.6.1.4.1.12356.101.4.1.4
        type: gauge
        help: Speicherauslastung in Prozent

      - name: fgSysMemCapacity
        oid: 1.3.6.1.4.1.12356.101.4.1.5
        type: gauge
        help: Gesamtspeicher in KB

      - name: fgSysDiskUsage
        oid: 1.3.6.1.4.1.12356.101.4.1.6
        type: gauge
        help: Belegter Speicher der Protokollpartition in MB

      - name: fgSysDiskCapacity
        oid: 1.3.6.1.4.1.12356.101.4.1.7
        type: gauge
        help: Groesse der Protokollpartition in MB

      - name: fgSysSesCount
        oid: 1.3.6.1.4.1.12356.101.4.1.8
        type: gauge
        help: Anzahl aktiver Sitzungen

      - name: fgSysLowMemUsage
        oid: 1.3.6.1.4.1.12356.101.4.1.9
        type: gauge
        help: Auslastung des unteren Speicherbereichs in Prozent

      # --- Hardware-Sensoren: Luefter, Temperatur, Netzteile ---------
      - name: fgHwSensorEntValue
        oid: 1.3.6.1.4.1.12356.101.4.3.2.1.3
        type: gauge
        help: Messwert des Hardware-Sensors
        indexes:
          - labelname: fgHwSensorEntIndex
            type: gauge
        lookups:
          - labels: [fgHwSensorEntIndex]
            labelname: fgHwSensorEntName
            oid: 1.3.6.1.4.1.12356.101.4.3.2.1.2
            type: DisplayString

      - name: fgHwSensorEntAlarmStatus
        oid: 1.3.6.1.4.1.12356.101.4.3.2.1.4
        type: gauge
        help: 0 = im Normbereich, 1 = Alarm
        indexes:
          - labelname: fgHwSensorEntIndex
            type: gauge
        lookups:
          - labels: [fgHwSensorEntIndex]
            labelname: fgHwSensorEntName
            oid: 1.3.6.1.4.1.12356.101.4.3.2.1.2
            type: DisplayString

      # --- VPN-Tunnel ------------------------------------------------
      - name: fgVpnTunEntStatus
        oid: 1.3.6.1.4.1.12356.101.12.2.2.1.20
        type: gauge
        help: 1 = down, 2 = up
        indexes:
          - labelname: fgVpnTunEntIndex
            type: gauge
        lookups:
          - labels: [fgVpnTunEntIndex]
            labelname: fgVpnTunEntPhase1Name
            oid: 1.3.6.1.4.1.12356.101.12.2.2.1.2
            type: DisplayString

  # ================================================================ #
  # APC / Schneider USV
  # ================================================================ #
  apc_usv:
    walk:
      - 1.3.6.1.2.1.1
      - 1.3.6.1.4.1.318.1.1.1.2   # upsBattery
      - 1.3.6.1.4.1.318.1.1.1.3   # upsInput
      - 1.3.6.1.4.1.318.1.1.1.4   # upsOutput
    max_repetitions: 20
    timeout: 10s
    retries: 2
    metrics:

      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3
        type: gauge

      - name: upsBasicOutputStatus
        oid: 1.3.6.1.4.1.318.1.1.1.4.1.1
        type: gauge
        help: 2 = Netzbetrieb, 3 = Batteriebetrieb, 4 = Bypass

      - name: upsAdvBatteryCapacity
        oid: 1.3.6.1.4.1.318.1.1.1.2.2.1
        type: gauge
        help: Batterieladung in Prozent

      - name: upsAdvBatteryTemperature
        oid: 1.3.6.1.4.1.318.1.1.1.2.2.2
        type: gauge
        help: Batterietemperatur in Grad Celsius

      - name: upsAdvBatteryRunTimeRemaining
        oid: 1.3.6.1.4.1.318.1.1.1.2.2.3
        type: gauge
        help: Restlaufzeit in Hundertstelsekunden

      - name: upsAdvBatteryReplaceIndicator
        oid: 1.3.6.1.4.1.318.1.1.1.2.2.4
        type: gauge
        help: 2 = Batterie muss getauscht werden

      - name: upsAdvInputLineVoltage
        oid: 1.3.6.1.4.1.318.1.1.1.3.2.1
        type: gauge
        help: Eingangsspannung in Volt

      - name: upsAdvOutputLoad
        oid: 1.3.6.1.4.1.318.1.1.1.4.2.3
        type: gauge
        help: Ausgangslast in Prozent der Nennleistung
