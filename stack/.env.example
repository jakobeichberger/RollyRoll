# ===================================================================
# Schul-Monitoring – zentrale Konfiguration
# Diese Datei wird von bootstrap.sh nach .env kopiert und befuellt.
# Geheimnisse werden automatisch erzeugt, wenn sie leer bleiben.
# ===================================================================

# --- Allgemein ------------------------------------------------------
TZ=Europe/Vienna
STANDORT=Schule
# Hostname/IP unter dem der Monitoring-Server im Netz erreichbar ist.
# Wird fuer Grafana-Links, Agenten-Registrierung und Alarm-Mails benutzt.
MON_HOSTNAME=monitoring.schule.local

# --- Zugangsdaten (werden bei leerem Wert automatisch generiert) -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORT=
# Gemeinsames Geheimnis, das jeder Agent zur Anmeldung braucht.
AGENT_TOKEN=
# Wird aus AGENT_TOKEN abgeleitet (bcrypt) – nicht selbst setzen.
LOKI_BASICAUTH_HASH=

# --- Aufbewahrung ---------------------------------------------------
METRIK_AUFBEWAHRUNG=365d
METRIK_MAX_GROESSE=40GB
LOG_AUFBEWAHRUNG=90d
# Agenten, die sich so lange nicht gemeldet haben, werden entfernt.
AGENT_TIMEOUT_TAGE=30

# --- E-Mail-Alarmierung ---------------------------------------------
SMTP_HOST=smtp.schule.local
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_PASSWORT=
SMTP_VON=monitoring@schule.local
SMTP_TLS=true
# Mehrere Empfaenger mit Komma trennen
ALARM_EMPFAENGER=admin@schule.local
ALARM_EMPFAENGER_KRITISCH=admin@schule.local
ALARM_EMPFAENGER_SECURITY=admin@schule.local

# --- Optionaler Webhook (Teams, Slack, ntfy, ...) --------------------
# Leer lassen = deaktiviert
WEBHOOK_URL=

# --- UniFi ----------------------------------------------------------
# Profil "unifi" in bootstrap.sh aktivieren, damit unpoller startet.
UNIFI_URL=https://10.0.0.10:8443
UNIFI_BENUTZER=monitoring
UNIFI_PASSWORT=
UNIFI_SITES=all
UNIFI_IDS=true
UNIFI_DPI=false

# --- FortiGate ------------------------------------------------------
FORTIGATE_URL=https://10.0.0.1
FORTIGATE_TOKEN=
FORTIGATE_INSECURE=true

# --- SNMP -----------------------------------------------------------
SNMP_COMMUNITY=public
SNMP_MODUL_STANDARD=if_mib

# --- Geraeteerkennung ------------------------------------------------
# Netze, die selbsttaetig nach Geraeten durchsucht werden. Mehrere mit
# Komma trennen. Leer lassen = Suchlauf aus (der UniFi-Controller wird
# trotzdem abgefragt, sofern Zugangsdaten hinterlegt sind).
#   ERKENNUNG_NETZE=10.0.0.0/24,10.0.1.0/24,10.0.2.0/24
ERKENNUNG_NETZE=
# automatisch = Fundstuecke werden sofort mitueberwacht
# vorschlag   = nur auflisten, Uebernahme entscheidet der Mensch
ERKENNUNG_MODUS=automatisch
ERKENNUNG_INTERVALL_MINUTEN=60
# Sicherheitsnetz gegen zu weit gefasste Netzangaben
ERKENNUNG_HOECHSTZAHL=4096
# LLDP-Nachbarschaft mitabfragen: liefert den Netzplan (wer haengt an
# welchem Port). Kostet je Switch ein paar Sekunden.
ERKENNUNG_LLDP=ja

# --- Konfigurationssicherung der Netzgeraete -------------------------
# Laeuft naechtlich um 03:20 ueber den systemd-Zeitgeber
# schulmonitoring-konfig.timer. Braucht FORTIGATE_TOKEN bzw. die
# UniFi-Zugangsdaten von weiter oben - sonst passiert schlicht nichts.
# Ablage (Git-Verzeichnis, enthaelt Geheimnisse):
#   /opt/schulmonitoring/konfig

# --- Container-Images (bei Bedarf auf neuere Tags anheben) -----------
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.0
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.25.0
SNMP_IMAGE=prom/snmp-exporter:v0.26.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
LOKI_IMAGE=grafana/loki:3.4.1
GRAFANA_IMAGE=grafana/grafana:11.6.0
ALLOY_IMAGE=grafana/alloy:v1.7.1
CADDY_IMAGE=caddy:2.9-alpine
UNPOLLER_IMAGE=ghcr.io/unpoller/unpoller:latest
FORTIGATE_EXPORTER_IMAGE=ghcr.io/bluecmd/fortigate_exporter:latest

# --- Agent-Pakete, die fuer die Clients bereitgestellt werden --------
WINDOWS_EXPORTER_VERSION=0.30.5
ALLOY_WINDOWS_VERSION=1.7.1
