{
  "uid": "schule-netzwerk",
  "title": "Netzwerk – UniFi & FortiGate",
  "description": "Access Points, Switches und die Firewall der Schule.",
  "tags": ["schule", "netzwerk", "unifi", "fortigate"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Firewall",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "FortiGate CPU",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "fortigate_cpu_usage_ratio * 100 or fgSysCpuUsage", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "FortiGate Speicher",
      "description": "Ab etwa 88 % geht die FortiGate in den Konservierungsmodus und blockiert neue Verbindungen.",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "fortigate_memory_usage_ratio * 100 or fgSysMemUsage", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 88 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Aktive Sitzungen",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "fortigate_current_sessions or fgSysSesCount" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Hardware-Sensoren der FortiGate",
      "description": "Lüfter, Temperaturen und Netzteile – hier sieht man einen anbahnenden Hardwaredefekt der Firewall.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "fgHwSensorEntValue", "instant": true, "format": "table" }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "typ": true, "standort": true, "fgHwSensorEntIndex": true, "kritisch": true, "hersteller": true, "modul": true, "auth": true },
            "renameByName": { "geraet": "Gerät", "fgHwSensorEntName": "Sensor", "Value": "Messwert", "raum": "Raum" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "filterable": true }, "decimals": 1 }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Durchsatz an den FortiGate-Schnittstellen",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(fortigate_interface_receive_bytes_total[5m]) * 8", "legendFormat": "{{name}} ein" },
        { "refId": "B", "expr": "-rate(fortigate_interface_transmit_bytes_total[5m]) * 8", "legendFormat": "{{name}} aus" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never", "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "VPN-Tunnel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "fortigate_ipsec_tunnel_up", "legendFormat": "{{name}}" },
        { "refId": "B", "expr": "fgVpnTunEntStatus - 1", "legendFormat": "{{fgVpnTunEntPhase1Name}}" }
      ],
      "options": {
        "mergeValues": true, "showValue": "never", "alignValue": "center", "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "lineWidth": 0, "fillOpacity": 90 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "unten", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "oben", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "WLAN",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Erreichbarkeit der Access Points",
      "description": "Ping auf jeden AP – erkennt einen Ausfall auch dann, wenn der Controller selbst Probleme hat.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{typ=\"accesspoint\"}", "legendFormat": "{{geraet}} ({{raum}})" }],
      "options": {
        "mergeValues": true, "showValue": "never", "alignValue": "center", "rowHeight": 0.9,
        "legend": { "displayMode": "hidden", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "lineWidth": 0, "fillOpacity": 90 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "weg", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "erreichbar", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Geräte je Access Point",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "unpoller_radio_stations", "legendFormat": "{{name}} · {{radio}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "gradientMode": "opacity", "lineInterpolation": "smooth" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Kanalauslastung im Funk",
      "description": "Über 85 % wird das WLAN im Unterricht spürbar langsam.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "unpoller_radio_channel_utilization_total_ratio * 100", "legendFormat": "{{name}} · {{radio}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "continuous-GrYlRd" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "gradientMode": "scheme" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "PoE-Leistungsaufnahme je Switch",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (unpoller_port_poe_watts)", "legendFormat": "{{name}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never", "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Switches",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "table",
      "title": "Ports mit Übertragungsfehlern",
      "description": "Fast immer ein defektes Kabel, eine schlechte Steckverbindung oder ein sterbendes SFP-Modul.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sort_desc(rate(ifInErrors[15m]) + rate(ifOutErrors[15m]) > 0)", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "typ": true, "standort": true, "modul": true, "auth": true, "ifIndex": true, "kritisch": true },
            "renameByName": { "geraet": "Gerät", "ifName": "Port", "ifAlias": "Beschriftung", "raum": "Raum", "Value": "Fehler/s" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Fehler/s" },
            "properties": [
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Am stärksten ausgelastete Ports",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, 100 * 8 * rate(ifHCInOctets[15m]) / (ifHighSpeed * 1000000) > 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "typ": true, "standort": true, "modul": true, "auth": true, "ifIndex": true, "kritisch": true },
            "renameByName": { "geraet": "Gerät", "ifName": "Port", "ifAlias": "Beschriftung", "raum": "Raum", "Value": "Auslastung" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Auslastung" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "max", "value": 100 },
              { "id": "min", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 }] } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } }
    },
    {
      "id": 22,
      "type": "logs",
      "title": "Meldungen von Firewall und UniFi",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{job=\"syslog\"}" }],
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true,
        "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      }
    }
  ]
}
