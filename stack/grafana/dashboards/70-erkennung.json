{
  "uid": "schule-erkennung",
  "title": "Geräteerkennung",
  "description": "Was der Suchlauf im Netz gefunden hat – und was davon noch nicht ordentlich erfasst ist.",
  "tags": ["schule", "erkennung", "inventar"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-30d", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "typ",
        "label": "Gerätetyp",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(schule_erkanntes_geraet, typ)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "Alle", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Lage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Im Netz gefunden",
      "description": "Alle Geräte, die auf SNMP antworten oder dem UniFi-Controller bekannt sind.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "schule_erkennung_geraete_gesamt", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Noch nicht erfasst",
      "description": "Gefunden, aber weder in inventar.yml eingetragen noch mit einem Agenten versehen. Diese Geräte werden überwacht, tragen aber automatisch vergebene Namen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "schule_erkennung_unerfasst", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 26 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Letzter Suchlauf",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - schule_erkennung_letzter_lauf_zeitstempel",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7200 },
              { "color": "red", "value": 10800 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Dauer des Suchlaufs",
      "description": "Ein /24 sollte in wenigen Sekunden durch sein. Wird es deutlich mehr, ist ERKENNUNG_NETZE zu weit gefasst.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "schule_erkennung_dauer_sekunden", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 120 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 105,
      "type": "piechart",
      "title": "Gefundene Geräte nach Art",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "schule_erkennung_nach_typ",
          "legendFormat": "{{typ}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 106,
      "type": "row",
      "title": "Noch zu erledigen",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 107,
      "type": "table",
      "title": "Gefunden, aber noch nicht erfasst",
      "description": "Diese Geräte werden bereits überwacht. Für einen sprechenden Namen und den Raum den passenden Block aus inventar/gefunden.yml nach inventar.yml übernehmen – danach verschwindet die Zeile hier von selbst.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "schule_erkanntes_geraet{erfasst=\"nein\", typ=~\"$typ\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "erfasst": true,
              "standort": true
            },
            "renameByName": {
              "geraet": "Vorgeschlagener Name",
              "adresse": "IP-Adresse",
              "typ": "Erkannt als",
              "hersteller": "Hersteller",
              "quelle": "Gefunden über"
            },
            "indexByName": {
              "geraet": 0,
              "adresse": 1,
              "typ": 2,
              "hersteller": 3,
              "quelle": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "IP-Adresse", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "filterable": true } },
        "overrides": []
      }
    },
    {
      "id": 108,
      "type": "row",
      "title": "Alles Gefundene",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 109,
      "type": "table",
      "title": "Vollständige Liste",
      "description": "Jedes Gerät, das der Suchlauf je gesehen hat, mit dem Zeitpunkt der ersten Sichtung.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "schule_erkanntes_geraet{typ=~\"$typ\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "schule_erkanntes_geraet_erste_sichtung_zeitstempel * 1000",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "adresse", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Value #A": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "standort": true,
              "geraet 2": true
            },
            "renameByName": {
              "geraet": "Name",
              "geraet 1": "Name",
              "adresse": "IP-Adresse",
              "typ": "Art",
              "hersteller": "Hersteller",
              "quelle": "Gefunden über",
              "erfasst": "Erfasst",
              "Value #B": "Erstmals gesehen"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Erstmals gesehen", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Erstmals gesehen" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          },
          {
            "matcher": { "id": "byName", "options": "Erfasst" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ja": { "text": "ja", "color": "green", "index": 0 },
                      "nein": { "text": "noch nicht", "color": "orange", "index": 1 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "id": 110,
      "type": "row",
      "title": "Netzplan – was hängt woran",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 111,
      "type": "stat",
      "title": "Erfasste Verbindungen",
      "description": "Aus den LLDP-Nachbarschaftstabellen der Switches. Jede Strecke erscheint zweimal, wenn beide Seiten LLDP sprechen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 34 },
      "targets": [
        { "refId": "A", "expr": "schule_lldp_verbindungen_gesamt", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      }
    },
    {
      "id": 112,
      "type": "bargauge",
      "title": "Nachbarn je Gerät",
      "description": "Fällt dieser Wert plötzlich, ist eine Strecke weg – oft bevor ein Ping ausbleibt.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 4, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "schule_lldp_nachbarn",
          "legendFormat": "{{geraet}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "id": 113,
      "type": "table",
      "title": "Wer hängt an welchem Port",
      "description": "Bei einem ausgefallenen Uplink zeigt diese Tabelle sofort, welche Geräte dahinter liegen – statt zu raten, warum ein ganzer Trakt offline ist.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 34 },
      "targets": [
        { "refId": "A", "expr": "schule_lldp_verbindung", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "adresse": true
            },
            "renameByName": {
              "geraet": "Gerät",
              "lokal_port": "Port",
              "nachbar": "Dort hängt",
              "nachbar_port": "dessen Port"
            },
            "indexByName": {
              "geraet": 0,
              "lokal_port": 1,
              "nachbar": 2,
              "nachbar_port": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Gerät", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "filterable": true } },
        "overrides": []
      }
    }
  ]
}
