{
  "uid": "schule-leistung",
  "title": "Hardware-Leistung & Protokolle",
  "description": "Was die Hardware leistet, was sie an Fehlern zählt und was sie protokolliert — an einer Stelle.",
  "tags": ["schule", "hardware", "leistung"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "geraet",
        "label": "Gerät",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=\"windows\"}, geraet)", "refId": "A" },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Fehlerdaten – was die Geräte an Hardwarefehlern zählen",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "table",
      "title": "Hardwarefehler der letzten 24 Stunden",
      "description": "Nach Bereich getrennt: Ein Speichercontroller-Problem ist eine andere Baustelle als ein Dateisystemfehler, auch wenn beides nach Plattenproblem aussieht.",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sort_desc(schule_hardware_fehler_24h{geraet=~\"$geraet\"} > 0)", "instant": true, "format": "table" },
        { "refId": "B", "expr": "schule_hardware_ereignisse_24h{geraet=~\"$geraet\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "geraet", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true, "Time 2": true,
              "__name__ 1": true, "__name__ 2": true,
              "job 1": true, "job 2": true,
              "instance 1": true, "instance 2": true,
              "typ 1": true, "typ 2": true,
              "standort 1": true, "standort 2": true,
              "quelle 2": true, "rolle 2": true, "raum 2": true,
              "betriebssystem 1": true, "betriebssystem 2": true,
              "agent_version 1": true, "agent_version 2": true,
              "modell 1": true, "modell 2": true,
              "domaene 1": true, "domaene 2": true
            },
            "renameByName": {
              "geraet": "Gerät",
              "quelle 1": "Bereich",
              "rolle 1": "Rolle",
              "raum 1": "Raum",
              "Value #A": "Fehler",
              "Value #B": "Einträge gesamt"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Fehler" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Einträge gesamt" },
            "properties": [{ "id": "decimals", "value": 0 }, { "id": "custom.width", "value": 140 }]
          },
          {
            "matcher": { "id": "byName", "options": "Bereich" },
            "properties": [{ "id": "custom.width", "value": 170 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "" },
        "sortBy": [{ "displayName": "Fehler", "desc": true }]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Verlauf je Bereich",
      "description": "Ein einzelner Ausschlag ist Zufall. Eine Treppe nach oben ist ein sterbendes Bauteil.",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (quelle) (schule_hardware_fehler_24h{geraet=~\"$geraet\"})", "legendFormat": "{{quelle}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "gradientMode": "opacity", "stacking": { "mode": "none", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Datenträger-Leistung",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Antwortzeit beim Lesen",
      "description": "Über 25 ms bei nennenswerter Last ist ein Alterungszeichen, über 100 ms steht das System für die Benutzer praktisch.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(10, schule:datentraeger_latenz_lesen:sekunden{geraet=~\"$geraet\"})", "legendFormat": "{{geraet}} · {{volume}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "gradientMode": "opacity", "lineInterpolation": "smooth" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.025 }, { "color": "red", "value": 0.1 }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Antwortzeit beim Schreiben",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(10, schule:datentraeger_latenz_schreiben:sekunden{geraet=~\"$geraet\"})", "legendFormat": "{{geraet}} · {{volume}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "gradientMode": "opacity", "lineInterpolation": "smooth" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.025 }, { "color": "red", "value": 0.1 }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Fehlerzähler der Laufwerke",
      "description": "Korrigierte Fehler sind kein Ausfall — aber ihre Zunahme ist der früheste messbare Hinweis auf eine kippende Platte.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(increase(schule_datentraeger_korrigierte_fehler{geraet=~\"$geraet\"}[24h]) > 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true, "instance": true,
              "typ": true, "standort": true, "rolle": true, "seriennummer": true,
              "betriebssystem": true, "agent_version": true, "domaene": true, "raum": true
            },
            "renameByName": { "geraet": "Gerät", "modell": "Laufwerk", "Value": "Korrigiert (24 h)" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Korrigiert (24 h)" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Zugriffe je Sekunde",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(10, schule:datentraeger_iops:gesamt{geraet=~\"$geraet\"})", "legendFormat": "{{geraet}} · {{volume}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Durchsatz",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(10, schule:datentraeger_durchsatz:bytes_pro_sekunde{geraet=~\"$geraet\"})", "legendFormat": "{{geraet}} · {{volume}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Netzwerkkarten und Arbeitsspeicher",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Übertragungsfehler und verworfene Pakete",
      "description": "Fast immer ein defektes Kabel, eine schlechte Steckverbindung oder ein sterbendes SFP-Modul — selten die Karte selbst.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(8, schule:netzwerkkarte_fehler:pro_sekunde{geraet=~\"$geraet\"} > 0)", "legendFormat": "Fehler · {{geraet}} · {{nic}}" },
        { "refId": "B", "expr": "topk(8, schule:netzwerkkarte_verworfen:pro_sekunde{geraet=~\"$geraet\"} > 0)", "legendFormat": "verworfen · {{geraet}} · {{nic}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Ausgehandelte Verbindungsgeschwindigkeit",
      "description": "Eine Gigabit-Karte, die mit 100 Mbit läuft, fällt sonst nur als „das Netz ist langsam\" auf.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sort(schule_netzwerkkarte_geschwindigkeit_bit{geraet=~\"$geraet\"})", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true, "instance": true,
              "typ": true, "standort": true, "mac": true, "raum": true,
              "betriebssystem": true, "agent_version": true, "domaene": true, "modell": true
            },
            "renameByName": { "geraet": "Gerät", "karte": "Karte", "treiber": "Adapter", "rolle": "Rolle", "Value": "Geschwindigkeit" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Geschwindigkeit" },
            "properties": [
              { "id": "unit", "value": "bps" },
              { "id": "custom.width", "value": 150 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 100000000 }, { "color": "green", "value": 1000000000 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Adapter" },
            "properties": [{ "id": "custom.width", "value": 260 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 22,
      "type": "table",
      "title": "Speichermodule",
      "description": "Meldet WHEA einen Speicherfehler, ist die erste Frage immer „welcher Riegel?\". Hier stehen Steckplatz, Hersteller und Teilenummer.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "schule_speichermodul_kapazitaet_bytes{geraet=~\"$geraet\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true, "instance": true,
              "typ": true, "standort": true, "rolle": true, "raum": true,
              "betriebssystem": true, "agent_version": true, "domaene": true, "modell": true
            },
            "renameByName": {
              "geraet": "Gerät", "steckplatz": "Steckplatz", "hersteller": "Hersteller",
              "teilenummer": "Teilenummer", "seriennummer": "Seriennummer", "Value": "Kapazität"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Kapazität" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 120 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Speicherzusage",
      "description": "Ist die Zusage aufgebraucht, verweigern Programme den Start — und zwar bevor der Arbeitsspeicher wirklich voll ist.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(10, schule:speicher_zusage:anteil{geraet=~\"$geraet\"}) * 100", "legendFormat": "{{geraet}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "continuous-GrYlRd" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "gradientMode": "scheme" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 85 }, { "color": "red", "value": 95 }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Hardware-Protokolle im Klartext",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Protokolleinträge je Stunde",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 47 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (geraet) (count_over_time({job=\"windows_events\", channel=\"Hardware\", geraet=~\"$geraet\"} [$__auto]))",
          "legendFormat": "{{geraet}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 31,
      "type": "logs",
      "title": "Alle Hardware-Meldungen",
      "description": "Gefüllt nach Anbieter, nicht nach Schweregrad — korrigierte WHEA-Fehler protokolliert Windows als „Information\", und genau die sind die früheste Vorwarnung.",
      "gridPos": { "h": 12, "w": 13, "x": 0, "y": 54 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{job=\"windows_events\", channel=\"Hardware\", geraet=~\"$geraet\"}" }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 32,
      "type": "logs",
      "title": "Nur die ernsten Befunde",
      "description": "Controller-Rücksetzungen, fehlerhafte Blöcke, Dateisystemfehler, Bluescreens, unkorrigierbare WHEA-Fehler und Defektmeldungen der Hersteller.",
      "gridPos": { "h": 12, "w": 11, "x": 13, "y": 54 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"windows_events\", channel=\"Hardware\", geraet=~\"$geraet\"} |~ \"(?i)\\\"event_id\\\":(7|51|55|98|129|140|153|1001)\\\\b|uncorrectable|nicht behebbar|failure|failed|degraded|predictive|defekt|redundan\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "exact",
        "sortOrder": "Descending"
      }
    }
  ]
}
