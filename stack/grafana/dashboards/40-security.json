{
  "uid": "schule-security",
  "title": "Sicherheit & Angriffserkennung",
  "description": "Was passiert auf den Geräten – und deutet etwas davon auf einen Angriff hin?",
  "tags": ["schule", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "geraet",
        "label": "Gerät",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"windows_events\"}, geraet)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Lage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Offene Sicherheitsmeldungen",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(ALERTS{alertstate=\"firing\", kategorie=\"security\"}) or vector(0)", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fehlanmeldungen (24 h)",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"windows_events\", channel=\"Security\", geraet=~\"$geraet\"} |= \"4625\" [24h]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Schadsoftware-Funde (24 h)",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"windows_events\", channel=\"Defender\"} |~ \"\\\"event_id\\\":111[67]\" [24h]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Von der Firewall blockierte Angriffe (24 h)",
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"syslog\", quelle=\"fortigate\"} |= \"subtype=\\\"ips\\\"\" [24h]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Geräte ohne Echtzeitschutz",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(schule_defender_echtzeitschutz == 0) or vector(0)", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Anmeldeversuche",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Fehlgeschlagene Anmeldungen je Gerät",
      "description": "Ein einzelner hoher Balken auf einem Gerät ist der typische Fingerabdruck eines Kennwortangriffs.",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (geraet) (count_over_time({job=\"windows_events\", channel=\"Security\", geraet=~\"$geraet\"} |= \"4625\" [$__auto])))",
          "legendFormat": "{{geraet}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Erfolgreiche Anmeldungen",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"windows_events\", channel=\"Security\", geraet=~\"$geraet\"} |= \"4624\" [$__auto]))",
          "legendFormat": "Anmeldungen"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Verdächtige Aktivitäten",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "logs",
      "title": "Rechteänderungen, neue Konten und Dienste",
      "description": "Ereignisse 4720 (neues Konto), 4728/4732/4756 (Gruppe), 7045 (neuer Dienst), 4698 (neue Aufgabe), 1102 (Protokoll geleert).",
      "gridPos": { "h": 11, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"windows_events\", geraet=~\"$geraet\"} |~ \"\\\"event_id\\\":(4720|4728|4732|4756|7045|4698|1102|4740)\""
        }
      ],
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true,
        "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      }
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Verdächtige Befehle und Werkzeuge",
      "description": "Verschleierte PowerShell, zweckentfremdete Bordmittel und bekannte Angriffswerkzeuge.",
      "gridPos": { "h": 11, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"windows_events\", geraet=~\"$geraet\"} |~ \"(?i)-enc(odedcommand)?\\\\s|FromBase64String|DownloadString|Invoke-Expression|certutil.*-urlcache|bitsadmin.*/transfer|mshta\\\\s+http|regsvr32.*scrobj|mimikatz|psexesvc|vssadmin.*delete\""
        }
      ],
      "options": {
        "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true,
        "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Firewall",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Angriffe nach Schweregrad",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (fg_stufe) (count_over_time({job=\"syslog\", quelle=\"fortigate\", fg_untertyp=\"ips\"} [$__auto]))",
          "legendFormat": "{{fg_stufe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 31,
      "type": "logs",
      "title": "Schwere Vorfälle an der Firewall",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"syslog\", quelle=\"fortigate\"} |~ \"severity=\\\"(high|critical)\\\"|subtype=\\\"virus\\\"|botnet\""
        }
      ],
      "options": {
        "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true,
        "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Sicherheitshygiene",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
      "type": "table",
      "title": "Geräte mit Schutzlücken",
      "description": "Virenschutz aus, Signaturen alt, Firewall aus oder lange keine Updates.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "schule_defender_echtzeitschutz", "instant": true, "format": "table" },
        { "refId": "B", "expr": "schule_defender_signatur_alter_tage", "instant": true, "format": "table" },
        { "refId": "C", "expr": "schule_patch_alter_tage", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "geraet", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true, "Time 2": true, "Time 3": true,
              "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
              "job 1": true, "job 2": true, "job 3": true,
              "instance 1": true, "instance 2": true, "instance 3": true,
              "typ 1": true, "typ 2": true, "typ 3": true,
              "standort 1": true, "standort 2": true, "standort 3": true,
              "rolle 2": true, "rolle 3": true,
              "raum 2": true, "raum 3": true
            },
            "renameByName": {
              "geraet": "Gerät",
              "rolle 1": "Rolle",
              "raum 1": "Raum",
              "Value #A": "Echtzeitschutz",
              "Value #B": "Signaturalter (Tage)",
              "Value #C": "Patchalter (Tage)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Echtzeitschutz" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "AUS", "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "aktiv", "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Signaturalter (Tage)" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 3 }, { "color": "red", "value": 7 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Patchalter (Tage)" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 45 }, { "color": "red", "value": 90 }] } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } }
    }
  ]
}
