{
  "uid": "schule-baseline",
  "title": "Sicherheits-Baseline",
  "description": "Sind die Geräte so eingestellt, wie es empfohlen wird? Geprüft gegen CIS, BSI-Grundschutz und die Microsoft Security Baseline.",
  "tags": [
    "schule",
    "security",
    "härtung"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Alarme",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
        "step": "60s",
        "tagKeys": "severity,kategorie,geraet",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{geraet}} · {{severity}}",
        "target": {
          "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
          "refId": "Anno"
        },
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "pruefung",
        "label": "Prüfung",
        "description": "Wählt aus, für welche Prüfung unten die betroffenen Geräte aufgelistet werden.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(schule_sicherheit_pruefung, pruefung)",
          "refId": "A"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "rolle",
        "label": "Rolle",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(schule_sicherheit_score_prozent, rolle)",
          "refId": "B"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Wie gut steht die Schule da?",
